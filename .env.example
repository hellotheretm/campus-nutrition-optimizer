# Copy to .env.local for development. Never commit real values.
# Everything here is read on the server only; nothing is exposed to the browser.

# --- Database -----------------------------------------------------------
# PostgreSQL connection string. Leave empty to use the embedded PGlite database.
DATABASE_URL=
# "disable" for servers without TLS, "no-verify" to skip certificate checks (not recommended).
DATABASE_SSL=
DATABASE_POOL_MAX=5
# PGlite data directory when DATABASE_URL is empty (default .data/pglite). "memory://" for a throwaway database.
PGLITE_DATA_DIR=
# Set to "false" to run migrations yourself (npm run db:migrate) instead of on first connection.
DB_AUTO_MIGRATE=true

# --- Authentication (Better Auth) --------------------------------------
# Required in production: 32+ random bytes. Also salts hashed client addresses for rate limiting.
BETTER_AUTH_SECRET=
# Public origin of the site, e.g. https://nutrition.example.edu
BETTER_AUTH_URL=http://localhost:3000
# Optional Google sign-in. Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---------------------------------------------------------------
# SMTP URL for verification and password-reset emails, e.g. smtps://user:pass@smtp.example.com:465
# Without it, emails are only stored: in development they appear at /dev/outbox; in production they are
# never delivered, so people cannot verify their address or reset a password. Set it for production.
SMTP_URL=
MAIL_FROM="Campus Nutrition Optimizer <no-reply@example.com>"

# --- Administration -------------------------------------------------------
# Comma-separated emails of administrators (the account's email must be verified).
ADMIN_EMAILS=
# Bearer token for /api/cron/sync (16+ characters). Vercel Cron sends it automatically.
CRON_SECRET=

# --- Demo campus ------------------------------------------------------------
# Fictional Demo University for trying the app. Defaults to on in development, off in production.
ENABLE_DEMO_UNIVERSITY=
# Set to "false" to stop generating demo menus automatically.
DEMO_AUTO_MENUS=true

# --- Nutrislice menu sync --------------------------------------------------
# See docs/MENU_DATA_INTEGRATION.md before turning this on.
# Unofficial sync from the public menu API, WITHOUT an agreement with Nutrislice.
# Nutrislice's terms don't permit automated access; it can be blocked at any time,
# and the interface labels these menus as unofficial.
NUTRISLICE_SYNC_ENABLED=false
# Authorized sync, once an agreement exists (takes precedence when both are set).
NUTRISLICE_SYNC_AUTHORIZED=false
NUTRISLICE_AUTHORIZATION_REF=
# Optional JSON mapping of location slugs to Nutrislice school and menu-type slugs.
# Leave empty to discover them from the provider's /schools/ list.
NUTRISLICE_LOCATION_MAP=
# Optional: a different API base, and the delay between requests (minimum 500 ms).
NUTRISLICE_API_BASE=
NUTRISLICE_REQUEST_DELAY_MS=1500

# --- Data files ---------------------------------------------------------------
# Override the USDA index or migrations location (defaults: data/usda/usda-index.json.gz, db/migrations).
USDA_INDEX_PATH=
MIGRATIONS_DIR=
